 #include <linux/platform_data/i2c-s3c2410.h>
 #include <linux/gpio_keys.h>
 #include <linux/input.h>
+#include <linux/pstore_ram.h>
 #include <linux/memblock.h>
 #include <linux/pm.h>
 #include <linux/reboot.h>
@@ -224,6 +225,31 @@
