homtom: power key as an input device, no kernel power-off on hold

The board file polled GPF0 (ON_OFF, active low) every 100 ms and called
kernel_power_off() after a 2 s hold. Remove that: the kernel takes no
action on the key any more, userland decides (short press = wake/UI,
5 s = reboot to storage, 10 s = power off).

Register a gpio-keys-polled device "homtom-keys" with one button,
KEY_POWER on GPF0, active low, 50 ms poll, 50 ms debounce. Events appear
on /dev/input/eventN (find N in /proc/bus/input/devices). Polled rather
than interrupt-driven: request_irq would switch GPF0 to its EINT0 function,
and statusd reads power_key from GPFDAT, which the S3C24xx manual calls
undefined for pins in a function mode. As a plain input GPF0 keeps working
for statusd.

The remaining 1 Hz work only prints the console liveness beacon (same
cadence as before: every second for 30 s, then every 10 s).

KEY_POWER maps to a function-key string in the default VT keymap; nothing
in this kernel powers off or reboots on it.

Defconfig: CONFIG_KEYBOARD_GPIO_POLLED=y.

Applies with -p1 after 0004.

--- a/arch/arm/mach-s3c/mach-homtom-go630.c
+++ b/arch/arm/mach-s3c/mach-homtom-go630.c
@@ -20,6 +20,8 @@
 #include <linux/platform_data/usb-s3c2410_udc.h>
 #include <linux/platform_data/s3c-hsudc.h>
 #include <linux/platform_data/i2c-s3c2410.h>
+#include <linux/gpio_keys.h>
+#include <linux/input.h>
 #include <linux/memblock.h>
 #include <linux/pm.h>
 #include <linux/reboot.h>
@@ -189,6 +191,37 @@
 	.gpio_uninit	= homtom_hsudc_gpio_uninit,
 	.phy_init	= homtom_hsudc_phy_init,
 	.phy_uninit	= homtom_hsudc_phy_uninit,
+};
+
+/*
+ * Power key: stock ON_OFF = GPF0 (EINT0), active low. Polled gpio-keys input device reporting KEY_POWER on
+ * /dev/input/eventN ("homtom-keys"). Polled rather than interrupt-driven so GPF0 stays a plain input and statusd's
+ * GPFDAT read of power_key stays valid. The kernel takes no action on the key; hold times are userland policy.
+ */
+static struct gpio_keys_button homtom_buttons[] = {
+	{
+		.code			= KEY_POWER,
+		.gpio			= S3C2410_GPF(0),
+		.active_low		= 1,
+		.desc			= "power",
+		.type			= EV_KEY,
+		.debounce_interval	= 50,
+	},
+};
+
+static struct gpio_keys_platform_data homtom_keys_pdata = {
+	.buttons	= homtom_buttons,
+	.nbuttons	= ARRAY_SIZE(homtom_buttons),
+	.poll_interval	= 50,
+	.name		= "homtom-keys",
+};
+
+static struct platform_device homtom_keys_device = {
+	.name	= "gpio-keys-polled",
+	.id	= -1,
+	.dev	= {
+		.platform_data	= &homtom_keys_pdata,
+	},
 };
 
 static struct platform_device *homtom_devices[] __initdata = {
@@ -198,6 +231,7 @@
 	&s3c2443_device_dma,
 	&s3c_device_rtc,
 	&s3c_device_i2c0,
+	&homtom_keys_device,
 };
 
