+#include <asm/memory.h>
 
 #include "hardware-s3c24xx.h"
 #include "map-s3c24xx.h"
@@ -336,34 +338,63 @@
 
 /*
  * Reboot/poweroff (the stock kernel did this in arch_reset()/gpio_suicide()).
- * SWRST lives in the statically mapped clock block (S3C_VA_SYS = 0xF6100000, +0x44);
- * watchdog reset is the backup. Poweroff drives PWR_RST (GPJ10, active high on this board revision)
- * like gpio_suicide(); the PMIC cannot cut power on USB bus power, so fall back to a reboot.
- * Userspace: use "reboot -f" / "poweroff -f" (BusyBox otherwise signals a non-BusyBox PID 1).
+ * TTBL decides from INFORM0 (0x4C000070) after reset: 5 (watchdog) / 9 (software reset) = "Reboot", boots straight on;
+ * anything else = "Power down", where it sleeps unless the power key is held. Only 5 is ever written here; never 3.
+ *
+ * Default path (mode 0) is the stock s3c2443_cpu_reboot sequence (homtom-reset.S): INFORM0=5, a slow watchdog as backup,
+ * identity map, clean the caches, SDRAM refresh and system clock down to the crystal, then SWRST from a pre-fetched cache
+ * line with the MMU off, so no SDRAM access is in flight when the reset hits.
+ * Poweroff drives PWR_RST (GPJ10, active high on this board revision) like gpio_suicide(); the PMIC cannot cut power on
+ * USB bus power, so fall back to a reboot.
  */
-/* /sys/kernel/homtom_reboot_mode: 0 SWRST then WDT, 1 WDT only, 2 SWRST only, 3 PWR_RST low + WDT */
+/* /sys/kernel/homtom_reboot_mode: 0 stock sequence (default), 1 watchdog only, 2 direct SWRST (the k2 path); all INFORM0=5 */
 static int homtom_reboot_mode;
 
-static void homtom_restart(enum reboot_mode mode, const char *cmd)
+#define HOMTOM_INFORM0_REBOOT	5
+#define HOMTOM_CLKSRC_MSYSCLK_MPLL	(1u << 4)
+
+extern void __noreturn homtom_cpu_reboot(void __iomem *refresh, void __iomem *clksrc, u32 clksrc_slow,
+					 unsigned long do_reboot_phys);
+extern void homtom_do_reboot(void);
+
+/* WTCON: prescaler 0xff, clock /128, enable, reset. At PCLK 66 MHz one count is about 0.5 ms; slower after the clock drop. */
+static void homtom_wdt_arm(u32 count)
 {
-	void __iomem *sys = (void __iomem *)0xF6100000UL;
 	void __iomem *wdt = (void __iomem *)0xF6400000UL;
 
+	__raw_writel(0, wdt);
+	__raw_writel(count, wdt + 0x04);	/* WTDAT */
+	__raw_writel(count, wdt + 0x08);	/* WTCNT */
+	__raw_writel((0xff << 8) | (1 << 5) | (3 << 3) | (1 << 0), wdt);
+}
+
+static void homtom_restart(enum reboot_mode mode, const char *cmd)
+{
+	void __iomem *sys = (void __iomem *)0xF6100000UL;
+	u32 clksrc;
+
 	local_irq_disable();
-	/*
-	 * TTBL decides from INFORM0 (0x4C000070) after reset: 5 (watchdog) / 9 (software reset) = "Reboot", boots straight on;
-	 * anything else = "Power down", where it sleeps unless the power key is held. Verified by writing 5 then SWRST by hand.
-	 */
-	__raw_writel(homtom_reboot_mode == 2 ? 9 : 5, sys + 0x70);
-	if (homtom_reboot_mode != 1) {
+	local_fiq_disable();
+	__raw_writel(HOMTOM_INFORM0_REBOOT, sys + 0x70);
+
+	if (homtom_reboot_mode == 1) {
+		homtom_wdt_arm(0x10);
+		mdelay(5000);
+		return;
+	}
+	if (homtom_reboot_mode == 2) {
 		__raw_writel(0x533c2443, sys + 0x44);	/* S3C2443_SWRST */
 		mdelay(1000);
+		homtom_wdt_arm(0x10);
+		mdelay(5000);
+		return;
 	}
-	__raw_writel(0, wdt);			/* WTCON off */
-	__raw_writel(0x100, wdt + 0x08);	/* WTCNT */
-	__raw_writel(0x100, wdt + 0x04);	/* WTDAT */
-	__raw_writel((1 << 5) | (1 << 0) | (1 << 3) | (0x80 << 8), wdt);	/* enable, reset, DIV16, prescale */
-	mdelay(5000);
+
+	/* Backup if SWRST does nothing: about 1 s at full speed, longer once the clock is down. */
+	homtom_wdt_arm(0x800);
+	clksrc = __raw_readl(sys + 0x20) & ~HOMTOM_CLKSRC_MSYSCLK_MPLL;
+	setup_mm_for_reboot();
+	homtom_cpu_reboot(S3C_VA_MEM + 0x10, sys + 0x20, clksrc, virt_to_idmap(homtom_do_reboot));
 }
 
 static void homtom_power_off(void)
