#!/bin/busybox sh
# BCSP link establishment only (no pin changes, no chip reset: a hardware reset clears the PSRAM settings written over BCCMD).
stty -F /dev/ttySAC1 115200 raw -echo -crtscts cs8 parenb -parodd
exec 7> /dev/ttySAC1
for f in '\0300\0000\0101\0000\0276\0332\0334\0355\0355\0300' \
	 '\0300\0000\0101\0000\0276\0254\0257\0357\0356\0300' \
	 '\0300\0000\0101\0000\0276\0255\0357\0357\0357\0300' \
	 '\0300\0000\0101\0000\0276\0336\0255\0320\0320\0300'; do
	echo -ne "$f" >&7
	sleep 1
done
exec 7>&-
