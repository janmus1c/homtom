#!/bin/busybox sh
# homtom-gps-aid: the "GPS aid" button of the Tools page (docs/SCREEN_TOOLS.md). Sends one $PSRF104 (approximate position
# and GPS time, warm start) with gpsaid as in docs/GPS_AIDING.md and shows the result as gps_aid=... in /tmp/ui.extra.
#   Position: INTERNAL:/homtom/gps.aid, first line "LAT LON [ALT]" (decimal degrees, metres), written by the user. It never
#             goes into the repo or a log: gpsaid prints the position, so its output is discarded.
#   Time:     the device clock (the Mac bridge sets it after boot); refused while the year reads before 2026.
#   Port:     gpsaid opens ttySAC2 write-only and keeps homtom-statusd's settings; statusd stays the only reader and keeps
#             running. Acceptance is read back from statusd's /tmp/rmc: the receiver's date turns into today's.
# Results: OK HH:MM (receiver date now today), sent HH:MM (sent, receiver date unchanged after 15 s), no gps.aid,
# bad gps.aid, clock unset, refused (gpsaid exit 3: port not at 4800 or a value out of range), port error, failed N.
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH
POS=/mnt/internal/homtom/gps.aid
say() { homtom-ui-extra "gps_aid=$1"; echo "homtom-gps-aid: $1" > /dev/kmsg 2> /dev/null; }
num() {
	case $1 in '' | - | . | *[!0-9.-]* | ?*-* | *.*.*) return 1 ;; esac
	return 0
}

homtom-lock gpsaid $$ || exit 0
trap 'rm -f /tmp/lock.gpsaid' EXIT
say sending
year=$(date -u +%Y)
case $year in 2[0-9][0-9][0-9]) ;; *) year=0 ;; esac
if [ "$year" -lt 2026 ]; then
	say "clock unset"
	exit 1
fi
if [ ! -f $POS ]; then
	say "no gps.aid"
	exit 1
fi
set -- $(head -n 1 $POS | sed -e 's/[[:space:]][[:space:]]*/ /g')
if [ $# -lt 2 ] || [ $# -gt 3 ] || ! num "$1" || ! num "$2" || ! num "${3:-0}"; then
	say "bad gps.aid"
	exit 1
fi
t=$(date -u +%H:%M)
gpsaid --send --lat "$1" --lon "$2" --alt "${3:-0}" --time now > /dev/null 2>&1
rc=$?
set --
case $rc in
0) ;;
2) say "bad gps.aid"; exit 1 ;;
3) say refused; exit 1 ;;
4) say "port error"; exit 1 ;;
*) say "failed $rc"; exit 1 ;;
esac
today=$(date -u +%d%m%y)
i=0
while [ $i -lt 15 ]; do
	sleep 1
	if [ "$(cut -d, -f10 /tmp/rmc 2> /dev/null)" = "$today" ]; then
		say "OK $t"
		exit 0
	fi
	i=$((i + 1))
done
say "sent $t"
exit 0
